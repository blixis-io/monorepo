{
  "name": "@blixis-io/testing",
  "version": "0.1.0",
  "description": "Test utilities for Blixis modules: createTestBlixis, test actors, and a capturing logger",
  "keywords": [
    "blixis",
    "cms",
    "headless-cms",
    "cloudflare-workers"
  ],
  "license": "MIT",
  "homepage": "https://blixis-docs.frosty-hill-6079.workers.dev",
  "bugs": {
    "url": "https://github.com/blixis-io/monorepo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blixis-io/monorepo.git",
    "directory": "packages/testing"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "default": "./dist/database.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. packages/testing"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "pg": "catalog:"
  },
  "peerDependencies": {
    "@blixis-io/contracts": "workspace:^",
    "@blixis-io/database": "workspace:^",
    "@blixis-io/events": "workspace:^",
    "@blixis-io/kernel": "workspace:^"
  },
  "devDependencies": {
    "@blixis-io/contracts": "workspace:*",
    "@blixis-io/database": "workspace:*",
    "@blixis-io/events": "workspace:*",
    "@blixis-io/kernel": "workspace:*",
    "@blixis-io/shared": "workspace:*",
    "@blixis-io/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
