{
  "name": "@blixis-io/testing",
  "version": "0.0.0",
  "description": "Test utilities for Blixis modules: createTestBlixis, test actors, and a capturing logger",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./database": {
      "types": "./dist/database.d.ts",
      "default": "./dist/database.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. packages/testing"
  },
  "dependencies": {
    "@blixis-io/contracts": "workspace:*",
    "@blixis-io/database": "workspace:*",
    "@blixis-io/events": "workspace:*",
    "@blixis-io/kernel": "workspace:*",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@blixis-io/shared": "workspace:*",
    "@blixis-io/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blixis-io/monorepo.git",
    "directory": "packages/testing"
  }
}
