{
  "name": "@blixis-io/content-api",
  "version": "0.1.0",
  "description": "Public content capabilities for Blixis modules: service tokens, entry and content type views, and content events (ADR 0016)",
  "keywords": [
    "blixis",
    "cms",
    "headless-cms",
    "cloudflare-workers"
  ],
  "license": "MIT",
  "homepage": "https://blixis-docs.frosty-hill-6079.workers.dev",
  "bugs": {
    "url": "https://github.com/blixis-io/monorepo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blixis-io/monorepo.git",
    "directory": "packages/content-api"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. packages/content-api"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@blixis-io/contracts": "workspace:^"
  },
  "devDependencies": {
    "@blixis-io/contracts": "workspace:*",
    "@blixis-io/tsconfig": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
