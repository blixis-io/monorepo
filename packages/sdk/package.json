{
  "name": "@blixis-io/sdk",
  "version": "0.0.0",
  "description": "Blixis SDK: typed clients for the Management API and the GraphQL delivery API",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --root ../.. packages/sdk"
  },
  "devDependencies": {
    "@blixis-io/assets": "workspace:*",
    "@blixis-io/auth": "workspace:*",
    "@blixis-io/content": "workspace:*",
    "@blixis-io/contracts": "workspace:*",
    "@blixis-io/database": "workspace:*",
    "@blixis-io/events": "workspace:*",
    "@blixis-io/graphql": "workspace:*",
    "@blixis-io/kernel": "workspace:*",
    "@blixis-io/permissions": "workspace:*",
    "@blixis-io/spaces": "workspace:*",
    "@blixis-io/testing": "workspace:*",
    "@blixis-io/tsconfig": "workspace:*",
    "@blixis-io/users": "workspace:*",
    "@blixis-io/webhooks": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blixis-io/monorepo.git",
    "directory": "packages/sdk"
  }
}
