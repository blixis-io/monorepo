{
  "name": "blixis",
  "private": true,
  "type": "module",
  "description": "Blixis \u2014 modular headless CMS on Cloudflare Workers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blixis-io/monorepo.git"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "lint": "biome check . && pnpm boundaries",
    "boundaries": "node tooling/boundaries/src/cli.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "test": "tsc -b && vitest run",
    "test:watch": "vitest",
    "test:coverage": "tsc -b && vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "lefthook": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
