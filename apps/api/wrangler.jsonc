{
  // Blixis API Worker — docs/operations/cloudflare.md
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blixis-api",
  "main": "src/index.ts",
  // Keep ≤ the runtime bundled with @cloudflare/vitest-pool-workers (ADR 0002).
  "compatibility_date": "2026-08-15",
  // nodejs_compat: required by @sentry/cloudflare (AsyncLocalStorage, 004.007) and pg (ADR 0006).
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Version id of each deploy; @sentry/cloudflare uses it as the release (unless SENTRY_RELEASE).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // Local development (wrangler dev).
  "vars": {
    "BLIXIS_ENV": "local",
    "LOG_LEVEL": "debug"
  },
  // Local Postgres from docker-compose.yml (docs/operations/database.md). The id is unused locally;
  // override the URL with CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
  // Events queue (simulated locally). Consumers are configured with the queue handler (006.004).
  "queues": { "producers": [{ "binding": "EVENTS", "queue": "blixis-events-local" }] },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://blixis:blixis@localhost:5432/blixis"
    }
  ],

  // Deployed environments. Vars and bindings are NOT inherited: declare everything per env.
  // Custom domains (api.staging.<domain>, api.<domain>) are added once the domain is decided.
  "env": {
    "staging": {
      // Worker name: blixis-api-staging
      "workers_dev": true,
      "preview_urls": false,
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "BLIXIS_ENV": "staging",
        "LOG_LEVEL": "info",
        // Sentry project private-m57/blixis-api (a DSN is not a secret).
        "SENTRY_DSN": "https://ade334947d3608d7b3e28b18f68f0431@o4512140257918976.ingest.de.sentry.io/4512141485408336"
      },
      // Hyperdrive blixis-staging → Neon branch staging, role blixis_app (DML only).
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "2140b66bf63640059dc89b926d10ca3a" }],
      "queues": { "producers": [{ "binding": "EVENTS", "queue": "blixis-events-staging" }] }
    },
    "production": {
      // Worker name: blixis-api-production. No public URL until a custom domain exists.
      "workers_dev": false,
      "preview_urls": false,
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "BLIXIS_ENV": "production",
        "LOG_LEVEL": "info",
        "SENTRY_DSN": "https://ade334947d3608d7b3e28b18f68f0431@o4512140257918976.ingest.de.sentry.io/4512141485408336"
      },
      // Hyperdrive blixis-production → Neon branch production, role blixis_app (DML only).
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "01eefb16f5004d80addedcfe9e69f430" }],
      "queues": { "producers": [{ "binding": "EVENTS", "queue": "blixis-events-production" }] }
    }
  }
}
