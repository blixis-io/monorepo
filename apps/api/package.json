{
  "name": "@blixis-io/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Blixis API Worker: composition root for all modules (REST, later GraphQL)",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types && rm -f tsconfig.tsbuildinfo",
    "types:check": "wrangler types --check",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist --env staging && wrangler deploy --dry-run --outdir dist --env production",
    "test": "vitest run --root ../.. --project api",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "dependencies": {
    "@blixis-io/assets": "workspace:*",
    "@blixis-io/auth": "workspace:*",
    "@blixis-io/cloudflare": "workspace:*",
    "@blixis-io/content": "workspace:*",
    "@blixis-io/contracts": "workspace:*",
    "@blixis-io/database": "workspace:*",
    "@blixis-io/events": "workspace:*",
    "@blixis-io/graphql": "workspace:*",
    "@blixis-io/kernel": "workspace:*",
    "@blixis-io/permissions": "workspace:*",
    "@blixis-io/spaces": "workspace:*",
    "@blixis-io/users": "workspace:*",
    "@blixis-io/webhooks": "workspace:*",
    "@sentry/cloudflare": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@blixis-io/sdk": "workspace:*",
    "@blixis-io/tsconfig": "workspace:*",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
