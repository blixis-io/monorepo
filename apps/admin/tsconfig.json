{
  "extends": "@blixis/tsconfig/base.json",
  "display": "Blixis admin (browser; bundled by Vite, type-checked by tsc -b)",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src", "test", "e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"],
  "references": [{ "path": "../../packages/sdk" }]
}
