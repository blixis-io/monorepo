{
  "name": "@blixis-io/example-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Example Astro site reading Blixis through @blixis-io/sdk (plan 017.004)",
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs dev",
    "build": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs build",
    "build:preview": "BLIXIS_PREVIEW=1 node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs build --outDir dist-preview",
    "preview": "node --env-file-if-exists=.env ./node_modules/astro/bin/astro.mjs preview",
    "seed": "node scripts/seed.ts"
  },
  "dependencies": {
    "@blixis-io/sdk": "workspace:*",
    "astro": "catalog:"
  },
  "devDependencies": {
    "@blixis-io/assets": "workspace:*",
    "@blixis-io/auth": "workspace:*",
    "@blixis-io/content": "workspace:*",
    "@blixis-io/contracts": "workspace:*",
    "@blixis-io/database": "workspace:*",
    "@blixis-io/events": "workspace:*",
    "@blixis-io/graphql": "workspace:*",
    "@blixis-io/permissions": "workspace:*",
    "@blixis-io/spaces": "workspace:*",
    "@blixis-io/testing": "workspace:*",
    "@blixis-io/users": "workspace:*",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
