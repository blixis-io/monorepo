{
  "name": "@blixis/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Blixis developer documentation (Starlight)",
  "scripts": {
    "dev": "pnpm -w run build && astro dev",
    "build": "pnpm -w run build && astro build",
    "preview": "astro preview",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:dry": "pnpm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/starlight": "catalog:",
    "astro": "catalog:"
  },
  "devDependencies": {
    "starlight-typedoc": "0.23.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "6.0.3",
    "wrangler": "catalog:"
  }
}
