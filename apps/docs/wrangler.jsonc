{
  // Assets-only Worker serving the prebuilt Starlight site (no Worker script).
  // Docs: docs/operations/cloudflare.md · Task 023.004
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "blixis-docs",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
